PORT=3001
# 0.0.0.0 = reachable on the LAN. Use 127.0.0.1 to keep API local-only
# (UI on LAN still works via Vite proxy when both run on this PC).
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed by CORS (needed if the client
# calls the API by IP directly, e.g. VITE_API_BASE=http://192.168.x.x:3001).
# With default Vite proxy, same-origin /api is used and CORS is not required.
# Alias: CORS_ORIGINS is also read by the server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Required on shared LAN / production for DELETE student profiles (min 4 chars).
# Client will prompt once per browser session and send X-Admin-Token.
ADMIN_TOKEN=change-me-to-a-long-secret

# Optional: live mirror of each evaluation to Google Sheets (fire-and-forget).
# Leave unset to disable — app behaves as before.
# GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GOOGLE_SHEETS_TAB=Sessions
# Pick ONE credential source:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
